{
  "_comment": "pkos-gptimage2use 配置示例——真实部署复制为 config.json 并设置环境变量 PKOS_IMG_API_KEY；本文件不含任何明文密钥",
  "active_provider": "gptimage2",
  "providers": {
    "gptimage2": {
      "kind": "openai-compatible",
      "endpoint": "http://<LLM_GATEWAY_HOST>:1519/v1",
      "auth_env": "PKOS_IMG_API_KEY",
      "model": "gpt-image-2",
      "defaults": {
        "size": "1024x1024",
        "quality": "auto",
        "output_format": "png",
        "background": "auto"
      },
      "quirks": {
        "transparent_bg_param": "background",
        "size_alias": {
          "square": "1024x1024",
          "portrait": "1024x1792",
          "wide": "1792x1024"
        },
        "retry_on_429": true,
        "response_path": "data[0].b64_json"
      }
    }
  },
  "failure_matrix": {
    "401": "fail-no-retry",
    "429": "retry-backoff",
    "5xx": "retry-once",
    "timeout": "fail-to-fallback"
  }
}
